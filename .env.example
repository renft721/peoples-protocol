# Copia este fichero como .env.local y rellena los valores. .env.local NUNCA se sube al repositorio.

# Dirección del RPC de Solana en DEVNET (la red de pruebas).
# Helius → API Keys → copia la URL de "Devnet" (https://devnet.helius-rpc.com/?api-key=...).
# Si se deja vacío se usa el RPC público de Solana devnet, más lento y con límites.
SOLANA_RPC_URL=

# Clave privada del emisor de demostración (la agencia ficticia), solo devnet.
# Se genera en la Fase 1 con un script; no la escribas a mano.
ISSUER_SECRET_KEY=
